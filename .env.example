# ============================================================
# EJEMPLO DE VARIABLES DE ENTORNO PARA DOCKER COMPOSE (raíz)
# ============================================================
# Copia este archivo como ".env" en la raíz del repositorio.
# Docker Compose lo carga automáticamente para resolver las
# variables ${...} definidas en docker-compose.yml.
# NUNCA subas ".env" al repositorio.
# ============================================================

# Password del usuario root de MySQL
MYSQL_ROOT_PASSWORD=<password-root-segura>

# Password del usuario "triage" de MySQL
# Debe coincidir con la que está en api/.env dentro de DATABASE_URL
MYSQL_PASSWORD=<password-del-usuario-triage>
