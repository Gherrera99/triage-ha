# ============================================================
# EJEMPLO DE VARIABLES DE ENTORNO PARA EL SERVICIO API
# ============================================================
# Copia este archivo como "api/.env" y reemplaza los valores
# con los secretos reales. NUNCA subas "api/.env" al repositorio.
# ============================================================

# Puerto en el que escucha el servidor Express
PORT=3000

# Secreto para firmar tokens JWT.
# Genera uno robusto con: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
# Debe tener al menos 32 caracteres aleatorios en producción.
JWT_SECRET=<cambia-esto-por-un-secreto-generado-de-64-bytes-hex>

# Cadena de conexión a MySQL (dentro de Docker usa el nombre del servicio "mysql")
# Formato: mysql://<usuario>:<password>@<host>:<puerto>/<base_de_datos>
DATABASE_URL="mysql://triage:<password-de-triage>@mysql:3306/triage_db"

# Orígenes permitidos para CORS (separados por coma, sin espacios)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
