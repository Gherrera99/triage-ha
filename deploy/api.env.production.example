# ============================================================
# api/.env de PRODUCCION - Hospital de la Amistad
# ============================================================
# Copiar como "api/.env" en el servidor.
# NUNCA commitear este archivo.
# ============================================================

PORT=3000

# JWT_SECRET - generar uno NUEVO por servidor con:
#   docker run --rm node:20-alpine node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 128 caracteres hex.
JWT_SECRET=CAMBIA_ESTO_genera_un_secret_de_64_bytes_hex_unico_por_servidor

# DATABASE_URL - la pwd debe coincidir con MYSQL_PASSWORD del .env raiz
DATABASE_URL="mysql://triage:CAMBIA_ESTO_triage_pwd_segura_20chars@mysql:3306/triage_db"

# CORS_ORIGIN - IP del servidor + puerto del web (ajustar si cambia el puerto)
CORS_ORIGIN=http://192.168.1.30:5173
