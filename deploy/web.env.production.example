# ============================================================
# web/.env de PRODUCCION - Hospital de la Amistad
# ============================================================
# Copiar como "web/.env" en el servidor.
# El frontend (browser) usa estas URLs para llegar a la API.
# Como el browser corre fuera de Docker, debe usar la IP del
# servidor desde la LAN del hospital.
#
# IMPORTANTE: en produccion el sistema corre con HTTPS (certificado
# emitido por mkcert e instalado en cada PC cliente). Por eso los
# esquemas son https://. Si por algun motivo se decide volver a HTTP
# plano, cambiar a http:// y vaciar el bind mount de certs en
# docker-compose.prod.yml.
# ============================================================

VITE_API_URL=https://192.168.1.30:3000
VITE_WS_URL=https://192.168.1.30:3000
