# ============================================================
# .env de PRODUCCION (raiz) - Hospital de la Amistad
# ============================================================
# Copiar como ".env" en la raiz del repo en el servidor.
# NUNCA commitear este archivo.
#
# Generar passwords fuertes con:
#   [System.Web.Security.Membership]::GeneratePassword(20, 4)
# ============================================================

# Password del usuario root de MySQL (16+ caracteres aleatorios)
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO_root_pwd_segura_20chars

# Password del usuario triage de MySQL
# Debe coincidir con la pwd dentro de DATABASE_URL en api/.env
MYSQL_PASSWORD=CAMBIA_ESTO_triage_pwd_segura_20chars
