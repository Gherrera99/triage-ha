# ============================================================
# EJEMPLO DE VARIABLES DE ENTORNO PARA EL SERVICIO WEB (Vite)
# ============================================================
# Copia este archivo como "web/.env" y ajusta las URLs si es necesario.
# NUNCA subas "web/.env" al repositorio si contiene valores sensibles.
# ============================================================

# URL base de la API REST
VITE_API_URL=http://localhost:3000

# URL del servidor WebSocket (Socket.io)
VITE_WS_URL=http://localhost:3000
